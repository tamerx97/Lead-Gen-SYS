{
  "name": "@leadgen/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy && prisma generate",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-admin": "node dist/src/scripts/createAdmin.js",
    "create-admin:dev": "tsx src/scripts/createAdmin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "jsonwebtoken": "9.0.2",
    "libphonenumber-js": "^1.13.11",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
