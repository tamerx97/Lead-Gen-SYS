# ---------------------------------------------------------------------------
# Production configuration for docker-compose.prod.yml
#   cp .env.production.example .env   (then edit — every value below matters)
# ---------------------------------------------------------------------------

# The domain this instance answers on. Point an A record at the server first;
# Caddy provisions the TLS certificate for this name automatically.
APP_DOMAIN=leads.example.com

# --- Database --------------------------------------------------------------
POSTGRES_USER=leadgen
POSTGRES_DB=leadgen
# Generate one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Admin session ---------------------------------------------------------
# Generate one:  openssl rand -base64 48
# The API refuses to boot in production if this is left at the dev default.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Rate limiting on the public ping/post endpoints ------------------------
# Per source API key, falling back to client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# --- Outbound delivery to buyer webhooks ------------------------------------
DELIVERY_TIMEOUT_MS=8000
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_BACKOFF_MS=500

# --- Logging: debug | info | warn | error -----------------------------------
LOG_LEVEL=info
