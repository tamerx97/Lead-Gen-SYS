# --- Database -------------------------------------------------------------
# Matches the credentials in the repo-root docker-compose.yml.
DATABASE_URL="postgresql://leadgen:leadgen@localhost:5432/leadgen?schema=public"

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Admin auth -----------------------------------------------------------
# CHANGE THIS before exposing the API to anything but localhost.
# In production the API refuses to boot if this is left at a placeholder that
# appears in this repo, or if it is shorter than 32 characters.
#   openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# Lifetime of the admin session cookie.
JWT_EXPIRES_IN="7d"
# Set to true when serving the dashboard over HTTPS (sets the Secure cookie flag).
COOKIE_SECURE=false

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call the management API with credentials.
CORS_ORIGIN="http://localhost:5173"

# --- Rate limiting on the public ping/post endpoints -----------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# --- Outbound delivery ----------------------------------------------------
DELIVERY_TIMEOUT_MS=8000
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_BACKOFF_MS=500

# --- Seed credentials (used by `npm run seed`) ----------------------------
SEED_ADMIN_EMAIL="admin@leadgen.local"
SEED_ADMIN_PASSWORD="admin12345"

# --- Log verbosity: debug | info | warn | error ---------------------------
LOG_LEVEL=info

# --- Serve the built dashboard from this same process ---------------------
# Set this to web/dist to run the whole product as one process on one port,
# with no separate web server and no CORS configuration. Leave unset to run
# the API alone. Requires `npm run build` in /web first.
# SERVE_WEB_DIR="../web/dist"
